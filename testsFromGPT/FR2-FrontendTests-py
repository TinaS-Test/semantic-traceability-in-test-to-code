def test_submit_button_starts_translation(page):
    """
    Verifies that clicking translateButton
    sends source text for translation.

    Semantic focus:
    initiate ("initiera")
    submit ("skicka")
    """

    page.goto("https://tina.ethernettrip.com")

    page.fill("#sourceText", "Hej världen")

    page.click("#translateButton")

    assert page.locator("#translationResultPanel").is_visible()